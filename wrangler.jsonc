{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextlevelbuilder-web",
  "account_id": "7ac87c90789159ae1b10b7d78f5dcc08",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "cache_option_enabled"
  ],
  "keep_names": false,
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *", "17 * * * *"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nextlevelbuilder-web"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "MCP_OAUTH_ENABLED": "true",
    "MCP_OAUTH_RESOURCE": "https://nextlevelbuilder.io/mcp",
    "MCP_OAUTH_LEGACY_RESOURCES": "https://mcp.nextlevelbuilder.io/mcp",
    "BUILDER_LEAGUE_ENABLED": "false",
    "LIVE_ENABLED": "true",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFVjTy75wVNVWXvG",
    "NEXT_PUBLIC_APP_URL": "https://nextlevelbuilder.io",
    "NEXT_PUBLIC_ASSETS_URL": "https://cdn.nextlevelbuilder.io",
    "COURSES_ACCESS_PLANS": "premium,vip",
    "CF_ACCOUNT_ID": "7ac87c90789159ae1b10b7d78f5dcc08",
    "ONBOARDING_V2_ENABLED": "true",
    "MEMBERSHIP_PAST_DUE_GRACE_DAYS": "7",
    "POLAR_SERVER": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nlb-prod",
      "database_id": "26d63f67-6c10-43bc-9e92-62062b8e8f79",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_STAGING",
      "bucket_name": "nlb-media-staging"
    },
    {
      "binding": "MEDIA_PUBLIC",
      "bucket_name": "nlb-media-public"
    },
    {
      "binding": "BUILDER_EVIDENCE",
      "bucket_name": "nlb-builder-evidence"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MCP_DELEGATION_JTI",
      "id": "fed692ed5b194ab08610acefe758841e"
    }
  ],
  "env": {
    "staging": {
      "name": "nextlevelbuilder-web-staging",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": {
        "crons": ["* * * * *", "17 * * * *"]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "nextlevelbuilder-web-staging"
        }
      ],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "MCP_OAUTH_ENABLED": "true",
        "MCP_OAUTH_RESOURCE": "https://staging.nextlevelbuilder.io/mcp",
        "MCP_OAUTH_LEGACY_RESOURCES": "",
        "BUILDER_LEAGUE_ENABLED": "true",
        "LIVE_ENABLED": "true",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFVjUpt2OL12upHT",
        "NEXT_PUBLIC_APP_URL": "https://staging.nextlevelbuilder.io",
        "NEXT_PUBLIC_ASSETS_URL": "https://cdn.nextlevelbuilder.io",
        "COURSES_ACCESS_PLANS": "premium,vip",
        "CF_ACCOUNT_ID": "7ac87c90789159ae1b10b7d78f5dcc08",
        "ONBOARDING_V2_ENABLED": "true",
        "MEMBERSHIP_PAST_DUE_GRACE_DAYS": "7",
        "POLAR_SERVER": "sandbox"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nlb-staging",
          "database_id": "e5ae18de-8fb3-468e-a9b4-53618b2f0748",
          "migrations_dir": "drizzle/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_STAGING",
          "bucket_name": "nlb-media-staging"
        },
        {
          "binding": "MEDIA_PUBLIC",
          "bucket_name": "nlb-media-staging-public"
        },
        {
          "binding": "BUILDER_EVIDENCE",
          "bucket_name": "nlb-builder-evidence-staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "MCP_DELEGATION_JTI",
          "id": "44a2a308a7074708aa9e7fb3f0e381b2"
        }
      ]
    }
  }
}
