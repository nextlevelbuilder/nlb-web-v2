{
  "name": "nlb-web-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "npm run build:packages && opennextjs-cloudflare build",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:staging": "npm run build:worker && opennextjs-cloudflare deploy --env=staging",
    "deploy:production": "npm run build:worker && opennextjs-cloudflare deploy --env=\"\"",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env=staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "build:packages": "npm run build --workspaces",
    "test:packages": "npm run test --workspaces",
    "type-check:packages": "npm run type-check --workspaces",
    "courses:transcribe": "bash scripts/courses/prepare-recording-transcript.sh",
    "courses:publish": "node scripts/courses/publish-recording.mjs"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@polar-sh/sdk": "^0.40.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.11.17",
    "gsap": "~3.12.5",
    "jose": "6.2.3",
    "lenis": "~1.1.20",
    "lucide-react": "^0.456.0",
    "next": "^16.1.6",
    "next-intl": "^4.4.0",
    "next-themes": "^0.4.6",
    "posthog-js": "1.435.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "resend": "^4.0.0",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "11.0.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@opennextjs/cloudflare": "^1.20.5",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.4.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.1.6",
    "miniflare": "^4.20260730.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "workerd@1.20260828.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true
  },
  "overrides": {
    "better-call": {
      "zod": "^3.25.76 || ^4.0.0"
    }
  },
  "workspaces": [
    "packages/contracts",
    "packages/cli",
    "packages/mcp"
  ]
}
